# Firestore backend credentials for local development
# Option 1: JSON credentials object
# FIREBASE_ADMIN_CREDENTIALS should be the full service account JSON string.
# Example: export FIREBASE_ADMIN_CREDENTIALS='{"type":"service_account",...}'

# Option 2: standard Google Application Credentials file path
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Option 3: individual service account fields
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
